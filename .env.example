# bps-2api compose 环境变量（复制成 .env，chmod 600；rsync 不覆盖它）
# 缺失项由 scripts/deploy.sh 在 bootstrap 现场生成。

# 对外端口（容器内固定 8080）
BPS_HOST_PORT=8301

# PostgreSQL（仅在 compose 网络内暴露，不映射公网）
# 单机不想用 PG：把 compose 里的 DATABASE_URL 注释掉，会退化为 /data 下的 JSON 文件存储
BPS_DB_USER=bps
BPS_DB_NAME=bps
BPS_DB_PASSWORD=change-me-openssl-rand-hex-16

# 本站鉴权：调用 /v1/* 需 Authorization: Bearer <这个值>
WEB2API_API_KEY=change-me-openssl-rand-hex-24

# 账号凭据落库加密键；换掉后旧令牌无法解密，需要重新导入
BPS_ENCRYPT_KEY=change-me-openssl-rand-hex-32

# 上游站点（bps / ChatGPT Excel 插件 agent）
VENDOR_API_BASE_URL=https://bps.openai.com/basispoints/api

# Anthropic 入口的思考档位上限（low|medium|high|max，默认 low）。
# OpenAI 入口直接吃请求里的 reasoning_effort，不受这个上限约束。
WEB2API_MAX_EFFORT=high

# 没指定模型时的兜底模型（/v1/messages 不带 model、无法识别的模型名都会落到它）。
WEB2API_DEFAULT_MODEL=gpt-5.6-sol

# 系统指令注入：bps 上游自带 Excel agent 提示词，默认 off；需要附加指令时给文本或指向文件
# BPS_SYSTEM_PROMPT=off
# BPS_SYSTEM_PROMPT_FILE=

TZ=Asia/Shanghai

# 镜像来源（拉取式部署 scripts/deploy-pull.sh 用；现场构建 scripts/deploy.sh 也会用它给镜像打名）
# BPS_IMAGE_REPO=your-dockerhub-user/bps-2api
# BPS_APP_TAG=app-latest
